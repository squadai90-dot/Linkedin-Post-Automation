# Unison Content OS — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE SETTING VITE_GROQ_API_KEY
#
# Vite inlines every VITE_* variable into the built JavaScript. Anyone who can
# open the built page can read the key out of the bundle. That is fine for a
# build that only ever runs on the marketing team's own machines, and wrong
# for a public URL.
#
# Two safer places to put the key, in order of preference:
#
#   1. Settings -> AI inside the app. The key is stored in that browser's
#      localStorage only. It never enters the saved session, an export, or the
#      repository. This is the recommended route and needs nothing here.
#
#   2. GROQ_API_KEY below, with api/ai.js deployed. The key stays on the
#      server and the browser never sees it. Use this for a shared URL.
#
# VITE_GROQ_API_KEY is only a convenience for local development so nobody has
# to paste a key after every hard refresh.
# ---------------------------------------------------------------------------

# --- Server-side (api/ai.js relay — the key never reaches the browser) ---
GROQ_API_KEY=
# Optional. Only needed if the team wants Anthropic as well.
ANTHROPIC_API_KEY=
# Optional shared secret so only your deployment can call the relay.
UNISON_RELAY_TOKEN=
# Optional. Milliseconds before the relay gives up on the model. Default 55000.
AI_TIMEOUT_MS=

# --- Client-side (bundled into the build — see the warning above) ---
# Free key from https://console.groq.com/keys
VITE_GROQ_API_KEY=
# "groq" (default, free) or "anthropic" (paid).
VITE_AI_PROVIDER=groq
# Only if the team also uses Anthropic.
VITE_ANTHROPIC_API_KEY=

# --- LinkedIn (optional; api/linkedin.js — see README) ---
# With these set, text posts can go straight to LinkedIn; Make handles image,
# video and poll posts. (Article, document, carousel and multi-image posts were
# removed from the product.)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Pin the API version the bridge sends. Defaults to a known-good one.
LINKEDIN_API_VERSION=

# --- Shared team workspace (optional; api/workspace.js — see README) ---
# Without these, every person's posts and calendar stay in their own browser.
# A free Upstash Redis database is enough: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. The key the shared document is stored under.
UNISON_WORKSPACE_KEY=

# ---------- AI artwork and video (optional, paid) ----------
# Set on the SERVER only. The browser never sees these.
# Leave unset and Unison keeps using its own free renderer.
#
# Images — one of:
OPENAI_API_KEY=
#   or
GOOGLE_API_KEY=
# Optional overrides:
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_USD=0.04
# GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001
#
# Video — one of (GOOGLE_API_KEY above also covers Veo):
RUNWAY_API_KEY=
# GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-001
# GOOGLE_VIDEO_USD_SEC=0.05
# RUNWAY_VIDEO_USD_SEC=0.12

# ---------- Canva (optional; api/canva.js) ----------
# Opens Unison's designs in Canva's editor and brings the edited design back,
# exports any of your Canva designs as the post's image or MP4 video, and —
# on Canva Enterprise — fills your own brand templates with the post.
# Create an integration at https://www.canva.com/developers/integrations
#
# Set on the SERVER only (Vercel -> Settings -> Environment Variables, then
# redeploy). The client secret and every token stay on the server: tokens are
# kept in an encrypted, HttpOnly cookie that no script in the page can read.
#
# Without these, Settings -> AI can hold the same three values for the current
# server process only (in memory). That is for local development; anything
# deployed should use these variables.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must exactly match a redirect URL configured on the Canva integration —
# normally the address Unison itself is served from.
CANVA_REDIRECT_URI=
# Recommended. A long random string (32+ chars) that encrypts the Canva
# session cookie. If unset, a key is derived from CANVA_CLIENT_SECRET, so
# rotating the secret signs everyone out of Canva.
CANVA_SESSION_SECRET=
# Optional. Milliseconds before the relay gives up on Canva. Default 30000.
CANVA_TIMEOUT_MS=
#
# Optional, in the Canva Developer Portal rather than here: Outside Canva ->
# Configuration -> Return navigation -> Return URL = your Unison address, so
# Canva's editor sends people straight back. See VERCEL-SETUP.md.

# ---------- Optional tuning, read by the relays ----------
# Everything below has a working default; set one only to change it.
# Listed here because an audit found api/ reading variables that this file
# never mentioned, which makes a deployment harder to reason about.

# api/publish.js — holds the Make webhook server-side so the browser never
# carries it. Without it, the address configured in Settings is used.
MAKE_LINKEDIN_WEBHOOK_URL=
# Milliseconds before each relay gives up on its upstream service.
PUBLISH_TIMEOUT_MS=
LINKEDIN_TIMEOUT_MS=
IMAGE_TIMEOUT_MS=
VIDEO_TIMEOUT_MS=
# Cost shown per generated image for the Google provider, in US dollars.
GOOGLE_IMAGE_USD=
# Pin the Runway model and API version the video relay asks for.
RUNWAY_VIDEO_MODEL=
RUNWAY_API_VERSION=

# NODE_ENV / VERCEL_ENV are set by the host, not by you. api/canva.js reads
# them to refuse browser-side Canva configuration on a deployed instance
# unless UNISON_RELAY_TOKEN is also set.
